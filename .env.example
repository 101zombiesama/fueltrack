# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# OpenAI API key, used by /api/parse-food to turn food descriptions into macros.
OPENAI_API_KEY=

# Secret used to sign session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Database URL. For local development, use a SQLite file (run `mkdir data` first):
#   TURSO_DATABASE_URL=file:data/local.db
# For a hosted Turso database, use its libsql:// URL.
TURSO_DATABASE_URL=file:data/local.db

# Only needed for a hosted Turso database; leave empty for a local file.
TURSO_AUTH_TOKEN=
